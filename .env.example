# =============================================================================
# OKORO FX backend environment template
#
# Copy this file to `.env` (which is git-ignored) and fill in real values.
# Never commit a populated `.env` or paste real secrets into this template.
#   cp backend/.env.example backend/.env
#
# Required in production (settings.py refuses to start without them):
#   SECRET_KEY, DJANGO_ALLOWED_HOSTS, DATABASE_URL, PAYSTACK_SECRET_KEY (live),
#   KYC_ENCRYPTION_KEY
# =============================================================================

# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------
# Never set DEBUG=True in production.
DEBUG=False

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string

# Extra hostnames to accept (comma-separated). RENDER_EXTERNAL_HOSTNAME and
# okoro-fx-backend-app.onrender.com are added automatically.
DJANGO_ALLOWED_HOSTS=api.example.com

# postgres://user:pass@host:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/forex_trader_db

# Optional: added to the Render host automatically when Render sets it.
RENDER_EXTERNAL_HOSTNAME=

# -----------------------------------------------------------------------------
# Email
#
# Termii (below) takes priority when TERMII_API_KEY is set. These SMTP values
# are only used when no Termii key is present (and as the console fallback in
# local DEBUG).
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=you@example.com
# Gmail app password (NOT your account password).
EMAIL_PASSWORD=
# The From/display address for the SMTP transport. NOTE: the settings variable
# is EMAIL_GENERAL, not DEFAULT_FROM_EMAIL.
EMAIL_GENERAL=you@example.com
EMAIL_SECURE=true
EMAIL_TLS=false

# Address shown in the support section/footer of rendered emails.
DEFAULT_SUPPORT_EMAIL=support@okorofx.com

# Public frontend URL used to build verify/reset/invite links.
FRONTEND_URL=https://okorofx.netlify.app
# Optional hosted brand logo; only rendered when set.
BRAND_LOGO_URL=
ADMIN_PANEL_URL=

# -----------------------------------------------------------------------------
# Termii (email transport - templates live on the Termii dashboard)
#
# Create the email configuration + template on the Termii dashboard and paste
# their IDs here. The dashboard template MUST contain the {{message}}
# placeholder (or set TERMII_BODY_VARIABLE to the placeholder you used), plus
# {{name}}, {{action_url}} and {{action_label}} for the buttons.
# See templates/emails/termii_email_template.html for the source-of-truth mirror.
# -----------------------------------------------------------------------------
TERMII_API_KEY=
TERMII_BASE_URL=https://v4.api.termii.com
TERMII_EMAIL_CONFIG_ID=
TERMII_TEMPLATE_ID=
TERMII_BODY_VARIABLE=message
TERMII_TIMEOUT=30

# Optional per-email dashboard templates, e.g.:
# TERMII_TEMPLATE_WELCOME_ID=
# TERMII_TEMPLATE_PASSWORD_RESET_ID=

# -----------------------------------------------------------------------------
# KYC (identity verification)
# -----------------------------------------------------------------------------
# Fernet key used to encrypt document numbers (NIN, BVN, ID numbers) at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Mandatory in production: the app refuses to start without it, because the
# only alternative is deriving it from SECRET_KEY -- and rotating SECRET_KEY
# would then make every stored document number undecryptable.
# In DEBUG the key is derived from SECRET_KEY automatically.
KYC_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Paystack (Nigeria payment gateway)
# -----------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=
# Live secret (sk_live_...). Test keys are rejected when DEBUG is off.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# -----------------------------------------------------------------------------
# Service charges (percentages)
# -----------------------------------------------------------------------------
FUNDING_FEE_PERCENT=1.5
WITHDRAWAL_FEE_PERCENT=1.5
MIN_WITHDRAWAL=1000

# -----------------------------------------------------------------------------
# Deriv API
# -----------------------------------------------------------------------------
DERIV_API_TOKEN=
DERIV_API_URL=wss://ws.binaryws.com/websockets/v3
DERIV_APP_ID=1089

# -----------------------------------------------------------------------------
# CORS / CSRF (comma-separated). Defaults cover the Netlify/Vercel deployments
# plus local CRA (3000) and Vite (5173) dev servers.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://okorofx.netlify.app,https://forex-trader-frontend.vercel.app,http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://okorofx.netlify.app,https://forex-trader-frontend.vercel.app,http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
THROTTLE_ANON=60/hour
THROTTLE_USER=600/hour

# -----------------------------------------------------------------------------
# Security (applied when DEBUG is off)
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# -----------------------------------------------------------------------------
# Discord alerts (operational monitoring)
#
# Create a private Discord channel, then Channel settings -> Integrations ->
# Webhooks -> New Webhook -> Copy Webhook URL.
#
# Treat this URL like a password: anyone who has it can post to the channel.
# It is never logged or returned by the API. Leave it blank to disable alerting
# entirely. A second, optional webhook can receive info/warning events so the
# error channel stays quiet enough to keep mobile notifications on.
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
# Optional: info/warning events (service started, KYC activity). Falls back to
# DISCORD_WEBHOOK_URL when unset.
DISCORD_ACTIVITY_WEBHOOK_URL=
# Kill switch. Defaults to true whenever a webhook URL is configured.
DISCORD_ALERTS_ENABLED=true
# production | staging | local (shown on every alert). Defaults from DEBUG.
APP_ENV=production
# Render injects RENDER_GIT_COMMIT automatically; included in alerts.
# RENDER_GIT_COMMIT=

# Large-event warning thresholds, in the account currency (NGN).
ALERT_LARGE_DEPOSIT=500
ALERT_LARGE_WITHDRAWAL=500
ALERT_LARGE_TRADE=1000

# Shared secret for the scheduled-check endpoint. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Send it as the X-Cron-Secret header to POST /api/monitoring/run-checks/.
CRON_SECRET=
# Daily summary is opt-in. When true, the same protected endpoint accepts
# ?task=daily_summary.
ENABLE_DAILY_SUMMARY=false

# Frontend error intake: strict per-IP rate limit and an 8 KB body cap.
THROTTLE_MONITORING_CLIENT=10/min
MONITORING_CLIENT_ERROR_MAX_BYTES=8192
# Origins allowed to POST /api/monitoring/client-error/.
MONITORING_CLIENT_ORIGINS=https://okorofx.netlify.app,https://forex-trader-frontend.vercel.app,http://localhost:3000,http://localhost:5173
# Optional directory for the "service started" restart-loop marker.
# DISCORD_STATE_DIR=

# -----------------------------------------------------------------------------
# Market data (binary options)
#
# Twelve Data serves forex, commodities and stocks; CoinGecko serves crypto.
# Both are optional: without a key the market app serves a deterministic
# simulated feed so the app still runs offline. Restart the server after editing.
# -----------------------------------------------------------------------------
TWELVE_DATA_API_KEY=
# Demo keys (CG-...) belong on api.coingecko.com; Pro keys need
# COINGECKO_BASE_URL=https://pro-api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Requests/minute allowed per provider before it serves its last known good
# quote instead of calling upstream (Twelve Data free = 8, CoinGecko demo = 30).
# Raise these to match a paid plan.
TWELVE_DATA_REQUESTS_PER_MINUTE=8
COINGECKO_REQUESTS_PER_MINUTE=30
# Seconds a quote (and the CoinGecko batch) is cached.
MARKET_QUOTE_TTL=3
